{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build openmp",
      "type": "shell",
      "command": "g++",
      "args": [
        "-fopenmp",
        "-O2",
        "-g",
        "-Wall",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run openmp",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "dependsOn": "build openmp",
      "problemMatcher": []
    }
  ]
}
